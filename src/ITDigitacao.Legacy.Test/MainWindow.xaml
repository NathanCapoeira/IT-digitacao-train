<Window x:Class="ITDigitacao.Legacy.Test.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="IT Digitação — Teste Legacy" Height="520" Width="760" WindowStartupLocation="CenterScreen" Background="#FFF5F5F5">
  <Border Margin="24" Background="White" CornerRadius="14" BorderBrush="#FFE4E4E4" BorderThickness="1">
    <DockPanel>
      <Border DockPanel.Dock="Top" Background="#FFB5121B" CornerRadius="14,14,0,0" Padding="20"><TextBlock Text="IT DIGITAÇÃO • TESTE DE COMPATIBILIDADE" Foreground="White" FontSize="22" FontWeight="Bold"/></Border>
      <StackPanel Margin="28" VerticalAlignment="Center">
        <Image Source="Assets/logo-instituto.png" Height="74" HorizontalAlignment="Left" Margin="0,0,0,18"/>
        <TextBlock Text="Digite uma frase com acentuação brasileira:" FontSize="18" Margin="0,0,0,10"/>
        <TextBox x:Name="TypingBox" FontSize="20" Padding="10" Text="Ação, coração, ônibus e informação."/>
        <Button Content="Testar botão" Width="150" Height="42" Margin="0,18,0,12" HorizontalAlignment="Left" Click="TestButton_Click"/>
        <TextBlock x:Name="StatusText" FontSize="15" TextWrapping="Wrap"/>
      </StackPanel>
    </DockPanel>
  </Border>
</Window>
