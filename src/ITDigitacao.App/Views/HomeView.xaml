<UserControl x:Class="ITDigitacao.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="BenefitTemplate">
            <Border Style="{StaticResource InformativeCardStyle}" Margin="5,0,5,10"
                    MinHeight="78">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardIconTileStyle}" Background="{Binding TileBrush}">
                        <Image Source="{Binding Icon}" Width="28" Height="28" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="16" />
                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="13"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel SizeChanged="Layout_SizeChanged">
        <Border Style="{StaticResource BannerStyle}" Padding="0" Margin="0,0,0,17">
            <Grid MinHeight="205">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <Viewbox Grid.ColumnSpan="2" Stretch="Fill" Margin="1" IsHitTestVisible="False">
                    <Grid Width="940" Height="205">
                        <Path Fill="#19FFFFFF" Data="M 915,15 C 894,90 808,86 755,115 C 802,65 886,73 915,15 Z" />
                        <Path Fill="#14FFFFFF" Data="M 924,56 C 896,131 806,131 744,155 C 799,111 876,112 924,56 Z" />
                        <Path Fill="#12FFFFFF" Data="M 925,100 C 888,179 795,177 716,189 C 787,154 884,160 925,100 Z" />
                        <Path Fill="#16FFFFFF" Data="M 20,177 C 85,173 149,190 179,197 C 106,192 70,189 61,200 L 28,200 Q 20,193 20,177 Z" />
                    </Grid>
                </Viewbox>

                <StackPanel x:Name="HeroCopy" Margin="28,22,0,22" VerticalAlignment="Center">
                    <TextBlock Text="Aprenda. Pratique. Transforme." FontWeight="SemiBold" FontSize="13"
                               Foreground="#FFF1F2" TextWrapping="Wrap" />
                    <TextBlock x:Name="HeroTitle" Text="Vamos aprender algo incrível hoje?" Margin="0,6,0,9"
                               FontSize="35" FontWeight="Bold" Foreground="White" TextWrapping="Wrap" />
                    <TextBlock Text="Descubra novos conhecimentos enquanto desenvolve suas habilidades no teclado."
                               FontSize="15" Foreground="White" TextWrapping="Wrap" MaxWidth="440"
                               HorizontalAlignment="Left" />
                </StackPanel>

                <Image x:Name="WelcomeMascot" Grid.Column="1" Margin="6,8,14,0"
                       Source="/IT-Digitacao;component/Assets/mascote-boas-vindas.png"
                       MaxHeight="207" Stretch="Uniform" VerticalAlignment="Bottom"
                       AutomationProperties.Name="Mascote do Instituto dando boas-vindas" />
            </Grid>
        </Border>

        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Image Source="{StaticResource ClockIcon}" Width="28" Height="28" Margin="0,1,8,0"
                   VerticalAlignment="Top" />
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="DurationTitle" Text="Escolha seu tempo de prática"
                           FontSize="21" FontWeight="Bold" TextWrapping="Wrap" />
                <TextBlock Text="Quanto tempo você tem disponível hoje?" FontSize="13"
                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <UniformGrid x:Name="DurationGrid" Columns="6" Margin="-5,0"
                     AutomationProperties.LabeledBy="{Binding ElementName=DurationTitle}"
                     KeyboardNavigation.TabNavigation="Once">
            <UniformGrid.Resources>
                <Style TargetType="RadioButton" BasedOn="{StaticResource DurationCardStyle}">
                    <Setter Property="GroupName" Value="PracticeDuration" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding Content, RelativeSource={RelativeSource Self}, StringFormat='{}{0} minutos'}" />
                </Style>
            </UniformGrid.Resources>
            <RadioButton Content="5" Checked="Duration_Checked" />
            <RadioButton x:Name="DefaultDuration" Content="10" Checked="Duration_Checked" />
            <RadioButton Content="15" Checked="Duration_Checked" />
            <RadioButton Content="20" Checked="Duration_Checked" />
            <RadioButton Content="25" Checked="Duration_Checked" />
            <RadioButton Content="30" Checked="Duration_Checked" />
        </UniformGrid>

        <Button x:Name="StartButton" Style="{StaticResource PrimaryButtonStyle}"
                Click="Start_Click" HorizontalAlignment="Center" Margin="0,8,0,14"
                AutomationProperties.Name="Começar minha aventura">
            <StackPanel Orientation="Horizontal">
                <Path Data="M0,0 L0,12 L10,6 Z" Fill="White" VerticalAlignment="Center" Margin="0,0,9,0" />
                <TextBlock Text="Começar minha aventura" />
                <Path Data="M0,5 H10 M6,1 L10,5 L6,9" Stroke="White" StrokeThickness="1.5"
                      VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>
        </Button>

        <ItemsControl x:Name="Benefits" Margin="-5,0" ItemTemplate="{StaticResource BenefitTemplate}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </StackPanel>
</UserControl>
