<UserControl x:Class="ITDigitacao.App.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="CategoryTemplate">
            <Button Style="{StaticResource CategoryCardStyle}" Margin="5" Click="Category_Click"
                    AutomationProperties.Name="{Binding Name}">
                <StackPanel>
                    <Border CornerRadius="9" Background="{Binding Accent}" Margin="0,0,0,9">
                        <Image Source="{Binding Artwork}" Height="74" Stretch="Uniform" />
                    </Border>
                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontSize="16" FontWeight="Bold" />
                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,4,0,8"
                               Foreground="{StaticResource MutedBrush}" FontWeight="Normal" />
                    <TextBlock Text="{Binding CountLabel}" Foreground="{StaticResource BrandDarkBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="ActivityTemplate">
            <Border Style="{StaticResource InformativeCardStyle}" Margin="0,0,0,8">
                <StackPanel>
                    <Border Background="{Binding DifficultyTint}" CornerRadius="7" Padding="8,3" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding Difficulty}" Foreground="{Binding DifficultyInk}"
                                   FontSize="12" FontWeight="SemiBold" />
                    </Border>
                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="18" FontWeight="Bold" Margin="0,5,0,0" />
                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,3,0,0" />
                    <TextBlock Text="{Binding LengthLabel}" TextWrapping="Wrap" FontSize="13" Margin="0,5,0,9"
                               Foreground="{StaticResource MutedBrush}" />
                    <Button Content="Praticar" Click="Practice_Click" HorizontalAlignment="Left"
                            AutomationProperties.Name="{Binding PracticeLabel}" Style="{StaticResource SecondaryButtonStyle}" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <Style x:Key="FilterStyle" TargetType="RadioButton" BasedOn="{StaticResource NavigationStyle}">
            <Setter Property="GroupName" Value="LibraryDifficulty" />
        </Style>
    </UserControl.Resources>

    <StackPanel SizeChanged="Layout_SizeChanged">
        <Button x:Name="BackButton" Content="← Biblioteca" HorizontalAlignment="Left" Margin="0,0,0,9"
                Click="Back_Click" Style="{StaticResource SecondaryButtonStyle}" Visibility="Collapsed" />
        <Border Style="{StaticResource BannerStyle}" Margin="0,0,0,13" Padding="20,12">
            <Grid MinHeight="115">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <Viewbox Grid.ColumnSpan="2" MaxHeight="114" HorizontalAlignment="Right" Stretch="Fill" IsHitTestVisible="False">
                    <Grid Width="310" Height="110">
                        <Path Data="M 302,8 C 290,64 208,57 159,84 C 206,46 276,48 302,8 Z" Fill="#25FFFFFF" />
                        <Path Data="M 303,39 C 286,94 210,86 145,106 C 203,72 272,81 303,39 Z" Fill="#19FFFFFF" />
                    </Grid>
                </Viewbox>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="Biblioteca educativa" TextWrapping="Wrap"
                               FontSize="29" FontWeight="Bold" Foreground="White" />
                    <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" Foreground="White" Margin="0,4,0,5" />
                    <TextBlock x:Name="CountsText" TextWrapping="Wrap" Foreground="#FFF1F2" FontSize="13" />
                </StackPanel>
                <Image x:Name="BannerArt" Grid.Column="1" MaxHeight="125" Stretch="Uniform" Margin="12,0,0,0" />
            </Grid>
        </Border>

        <DockPanel Margin="0,0,0,9">
            <Button DockPanel.Dock="Right" Content="Limpar" Click="ClearSearch_Click" Margin="8,0,0,0"
                    Style="{StaticResource SecondaryButtonStyle}" AutomationProperties.Name="Limpar pesquisa" />
            <Grid>
                <TextBox x:Name="SearchBox" Style="{StaticResource SearchFieldStyle}" Padding="34,8,8,8"
                         VerticalContentAlignment="Center" TextChanged="Search_Changed"
                         AutomationProperties.Name="O que você quer aprender hoje?" />
                <Path Data="M 11,6 A 5,5 0 1 1 1,6 A 5,5 0 1 1 11,6 M 10,10 L 15,15"
                      Stroke="{StaticResource MutedBrush}" StrokeThickness="1.7"
                      HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"
                      IsHitTestVisible="False" />
                <TextBlock Text="O que você quer aprender hoje?" VerticalAlignment="Center" Margin="34,0,4,0"
                           IsHitTestVisible="False" TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DockPanel>
        <WrapPanel Margin="0,0,0,7">
            <RadioButton x:Name="AllFilter" Content="Todas" Click="Filter_Click" Style="{StaticResource FilterStyle}" />
            <RadioButton Content="Iniciante" Tag="Iniciante" Click="Filter_Click" Style="{StaticResource FilterStyle}" />
            <RadioButton x:Name="IntermediateFilter" Content="Intermediário" Tag="Intermediário" Click="Filter_Click" Style="{StaticResource FilterStyle}" />
            <RadioButton Content="Avançado" Tag="Avançado" Click="Filter_Click" Style="{StaticResource FilterStyle}" />
        </WrapPanel>

        <TextBlock x:Name="Encouragement" Text="Muito bem! Escolha outro texto para continuar praticando."
                   Background="{StaticResource BrandTintBrush}" Padding="9" TextWrapping="Wrap" Visibility="Collapsed"
                   Foreground="{StaticResource BrandDarkBrush}" FontWeight="SemiBold" Margin="0,0,0,8" />
        <TextBlock x:Name="SessionText" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,8"
                   Foreground="{StaticResource BrandDarkBrush}" />
        <WrapPanel x:Name="SessionActions" Visibility="Collapsed">
            <Button x:Name="ResumeButton" Content="Retomar texto atual" Margin="0,0,8,10"
                    Click="Resume_Click" Style="{StaticResource SecondaryButtonStyle}" />
            <Button Content="Encerrar sessão" Margin="0,0,0,10"
                    Click="End_Click" Style="{StaticResource SecondaryButtonStyle}" />
        </WrapPanel>

        <Border x:Name="EmptyCard" Style="{StaticResource InformativeCardStyle}" Visibility="Collapsed" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="EmptyText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                <Button x:Name="ResetButton" Content="Limpar pesquisa e filtros" Margin="0,8,0,0" HorizontalAlignment="Left"
                        Click="Reset_Click" Style="{StaticResource SecondaryButtonStyle}" />
            </StackPanel>
        </Border>

        <ItemsControl x:Name="CategoryCards" ItemTemplate="{StaticResource CategoryTemplate}" Margin="-5,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
        <ItemsControl x:Name="ActivityCards" ItemTemplate="{StaticResource ActivityTemplate}" />

        <Border Style="{StaticResource InformativeCardStyle}" Background="{StaticResource BrandTintBrush}" Margin="0,10,0,0">
            <DockPanel>
                <Image x:Name="RandomMascot" DockPanel.Dock="Right" Width="116" Height="82" Margin="14,0,0,0"
                       Source="/IT-Digitacao;component/Assets/mascote-digitando.png"
                       AutomationProperties.Name="Mascote praticando digitação" Visibility="Collapsed" />
                <StackPanel>
                <TextBlock Text="⇄  Surpreenda-me!" FontSize="19" FontWeight="Bold" TextWrapping="Wrap" />
                <TextBlock Text="Escolha uma atividade ao acaso entre os resultados atuais." TextWrapping="Wrap" Margin="0,3,0,8" />
                <Button x:Name="RandomButton" Content="Escolher atividade" HorizontalAlignment="Left"
                        Click="Random_Click" Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </StackPanel>
</UserControl>
