<UserControl x:Class="ITDigitacao.App.Views.ResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Border Style="{StaticResource BannerStyle}" Margin="0,0,0,12">
            <Grid MinHeight="115">
                <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Sessão concluída" Foreground="White" FontSize="29" TextWrapping="Wrap" FontWeight="Bold" />
                    <TextBlock x:Name="Message" Foreground="White" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <Image Grid.Column="1" MaxHeight="139" Source="/IT-Digitacao;component/Assets/mascote-celebrando.png"
                       AutomationProperties.Name="Mascote comemorando" />
            </Grid>
        </Border>
        <Border x:Name="StarCard" Style="{StaticResource InformativeCardStyle}" Margin="0,0,0,8" Background="{StaticResource AchievementTintBrush}">
            <StackPanel>
                <TextBlock x:Name="StarIcons" Foreground="#875400" FontSize="24" />
                <TextBlock x:Name="StarExplanation" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <ItemsControl x:Name="MetricGrid" Margin="-4,0" SizeChanged="Metrics_SizeChanged">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource MetricCardStyle}" Margin="4,0,4,8">
                        <StackPanel>
                            <TextBlock Text="{Binding Label}" FontSize="13" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Value}" FontSize="21" FontWeight="Bold" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Style="{StaticResource InformativeCardStyle}" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="Conquistas da sessão" FontSize="20" FontWeight="Bold" />
                <ItemsControl x:Name="AchievementList" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <DockPanel Margin="0,4">
                            <TextBlock DockPanel.Dock="Left" Text="{Binding Icon}" Foreground="#865000" FontSize="19" MinWidth="27" />
                            <StackPanel>
                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Value}" FontSize="13" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
        <WrapPanel>
            <Button Content="Nova atividade" Click="New_Click" Margin="0,0,8,8" Style="{StaticResource PrimaryButtonStyle}" />
            <Button Content="Voltar ao início" Click="Back_Click" Margin="0,0,8,8" Style="{StaticResource SecondaryButtonStyle}" />
            <Button Content="Sair" Click="Exit_Click" Margin="0,0,8,8" Style="{StaticResource SecondaryButtonStyle}" />
        </WrapPanel>
    </StackPanel>
</UserControl>
