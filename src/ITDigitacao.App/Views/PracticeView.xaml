<UserControl x:Class="ITDigitacao.App.Views.PracticeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Border Style="{StaticResource BannerStyle}" Padding="20,12" Margin="0,0,0,12">
            <DockPanel>
                <TextBlock x:Name="ClockText" DockPanel.Dock="Right" Foreground="White" FontWeight="Bold"
                           FontSize="24" Margin="12,0,0,0" VerticalAlignment="Center"
                           AutomationProperties.Name="Tempo restante" />
                <StackPanel>
                    <TextBlock x:Name="ActivityTitle" Foreground="White" FontWeight="Bold" FontSize="24" TextWrapping="Wrap" />
                    <TextBlock x:Name="ActivityLevel" Foreground="#FFF1F2" FontSize="14" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>
        <TextBlock x:Name="WarningText" Foreground="{StaticResource BrandDarkBrush}" TextWrapping="Wrap"
                   FontWeight="SemiBold" Margin="0,0,0,8" />
        <UniformGrid x:Name="EditorPanels" Columns="2" SizeChanged="Panels_SizeChanged" Margin="-4,0">
            <Border Style="{StaticResource InformativeCardStyle}" Margin="4,0,4,8">
                <StackPanel>
                    <TextBlock Text="Texto de referência" FontWeight="Bold" FontSize="17" Margin="0,0,0,6" />
                    <ScrollViewer x:Name="ReferenceScroller" MaxHeight="220" MinHeight="155" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="ReferenceText" FontSize="17" TextWrapping="Wrap" Padding="0,0,6,0" />
                    </ScrollViewer>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource InformativeCardStyle}" Margin="4,0,4,8">
                <StackPanel>
                    <TextBlock x:Name="InputLabel" Text="Sua digitação" FontWeight="Bold" FontSize="17" Margin="0,0,0,6" />
                    <TextBox x:Name="Entry" MinHeight="155" MaxHeight="220" FontSize="17"
                             TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                             TextChanged="Entry_Changed" AllowDrop="False"
                             AutomationProperties.LabeledBy="{Binding ElementName=InputLabel}"
                             Style="{StaticResource SearchFieldStyle}" />
                </StackPanel>
            </Border>
        </UniformGrid>
        <Border Style="{StaticResource InformativeCardStyle}" Margin="0,3,0,8">
            <StackPanel>
                <TextBlock x:Name="MetricText" TextWrapping="Wrap" FontWeight="SemiBold" />
                <TextBlock x:Name="ProgressText" TextWrapping="Wrap" Margin="0,6" />
                <ProgressBar x:Name="ProgressMeter" Style="{StaticResource ProgressStyle}"
                             AutomationProperties.Name="Progresso do texto" />
            </StackPanel>
        </Border>
        <WrapPanel>
            <Button Content="Concluir texto" x:Name="CompleteButton" Click="Complete_Click"
                    Margin="0,0,8,8" Style="{StaticResource PrimaryButtonStyle}" />
            <Button Content="Voltar à biblioteca" Click="Back_Click" Margin="0,0,8,8" Style="{StaticResource SecondaryButtonStyle}" />
            <Button Content="Encerrar sessão" Click="End_Click" Margin="0,0,8,8" Style="{StaticResource SecondaryButtonStyle}" />
        </WrapPanel>
    </StackPanel>
</UserControl>
