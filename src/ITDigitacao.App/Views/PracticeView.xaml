<UserControl x:Class="ITDigitacao.App.Views.PracticeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Border Style="{StaticResource BannerStyle}" Padding="20,12" Margin="0,0,0,8">
            <DockPanel>
                <Border DockPanel.Dock="Right" Background="#37FFFFFF" CornerRadius="10" Padding="11,6"
                        Margin="10,0,0,0" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Tempo restante" Foreground="White" FontSize="11" />
                        <TextBlock x:Name="ClockText" Foreground="White" FontWeight="Bold" FontSize="23" />
                    </StackPanel>
                </Border>
                <StackPanel>
                    <TextBlock x:Name="ActivityLevel" Foreground="#FFF1F2" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock x:Name="ActivityTitle" Foreground="White" FontWeight="Bold" FontSize="22" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Border Style="{StaticResource InformativeCardStyle}" Padding="8,4" Margin="0,0,0,8">
            <WrapPanel>
                <Button Content="A−" AutomationProperties.Name="Diminuir fonte" Click="Smaller_Click"
                        Style="{StaticResource SecondaryButtonStyle}" MinHeight="34" Padding="10,4" Margin="0,2,5,2" />
                <TextBlock x:Name="FontValue" MinWidth="36" TextAlignment="Center" VerticalAlignment="Center" Margin="0,0,5,0" />
                <Button Content="A+" AutomationProperties.Name="Aumentar fonte" Click="Larger_Click"
                        Style="{StaticResource SecondaryButtonStyle}" MinHeight="34" Padding="10,4" Margin="0,2,5,2" />
                <Button x:Name="SoundButton" Click="Sound_Click" Style="{StaticResource SecondaryButtonStyle}"
                        MinHeight="34" Padding="10,4" Margin="0,2,5,2" />
                <Button x:Name="FocusButton" Click="Focus_Click" Style="{StaticResource SecondaryButtonStyle}"
                        MinHeight="34" Padding="10,4" Margin="0,2,5,2" />
                <Button Content="Reiniciar texto" Click="Restart_Click" Style="{StaticResource SecondaryButtonStyle}"
                        MinHeight="34" Padding="10,4" Margin="0,2,5,2" />
                <Button Content="Configurações" Click="Settings_Click" Style="{StaticResource SecondaryButtonStyle}"
                        MinHeight="34" Padding="10,4" Margin="0,2,5,2" />
            </WrapPanel>
        </Border>
        <TextBlock x:Name="WarningText" Foreground="{StaticResource BrandDarkBrush}" TextWrapping="Wrap"
                   FontWeight="SemiBold" Margin="0,0,0,8" />
        <UniformGrid x:Name="EditorPanels" Columns="2" SizeChanged="Panels_SizeChanged" Margin="-4,0">
            <Border Style="{StaticResource InformativeCardStyle}" Margin="4,0,4,8">
                <StackPanel>
                    <TextBlock Text="Texto de referência" FontWeight="Bold" FontSize="17" Margin="0,0,0,8" />
                    <ScrollViewer x:Name="ReferenceScroller" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="ReferenceText" TextWrapping="Wrap" Padding="4,0,8,0" />
                    </ScrollViewer>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource InformativeCardStyle}" Margin="4,0,4,8">
                <StackPanel>
                    <TextBlock x:Name="InputLabel" Text="Sua digitação" FontWeight="Bold" FontSize="17" Margin="0,0,0,8" />
                    <Grid>
                        <TextBox x:Name="Entry" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                 TextChanged="Entry_Changed" SelectionChanged="Entry_SelectionChanged" AllowDrop="False"
                                 AutomationProperties.LabeledBy="{Binding ElementName=InputLabel}"
                                 Style="{StaticResource SearchFieldStyle}" Padding="12,9" />
                        <TextBlock Text="Comece a digitar aqui…" Margin="16,12,8,0" Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=Entry}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </Border>
        </UniformGrid>
        <UniformGrid x:Name="MetricCards" Columns="4" Margin="-4,0,0,5">
            <Border Style="{StaticResource MetricCardStyle}" Margin="4,0,4,4"><StackPanel>
                <TextBlock Text="Palavras por minuto" TextWrapping="Wrap" FontSize="12" /><TextBlock x:Name="SpeedValue" FontSize="20" FontWeight="Bold" />
            </StackPanel></Border>
            <Border Style="{StaticResource MetricCardStyle}" Margin="4,0,4,4"><StackPanel>
                <TextBlock Text="Precisão" FontSize="12" /><TextBlock x:Name="AccuracyValue" FontSize="20" FontWeight="Bold" />
            </StackPanel></Border>
            <Border Style="{StaticResource MetricCardStyle}" Margin="4,0,4,4"><StackPanel>
                <TextBlock Text="Erros cometidos" TextWrapping="Wrap" FontSize="12" /><TextBlock x:Name="HistoricalErrors" FontSize="20" FontWeight="Bold" />
            </StackPanel></Border>
            <Border Style="{StaticResource MetricCardStyle}" Margin="4,0,4,4"><StackPanel>
                <TextBlock Text="Erros no texto" TextWrapping="Wrap" FontSize="12" /><TextBlock x:Name="CurrentErrors" FontSize="20" FontWeight="Bold" />
            </StackPanel></Border>
        </UniformGrid>
        <Border Style="{StaticResource InformativeCardStyle}" Margin="0,0,0,8" Padding="12,7">
            <StackPanel>
                <TextBlock x:Name="MetricText" TextWrapping="Wrap" Margin="0,0,0,4" FontSize="12" />
                <TextBlock x:Name="ProgressText" TextWrapping="Wrap" Margin="0,0,0,5" FontWeight="SemiBold" />
                <ProgressBar x:Name="ProgressMeter" Style="{StaticResource ProgressStyle}" AutomationProperties.Name="Progresso do texto" />
            </StackPanel>
        </Border>
        <WrapPanel>
            <Button Content="Concluir texto" x:Name="CompleteButton" Click="Complete_Click"
                    Margin="0,0,8,8" Style="{StaticResource PrimaryButtonStyle}" />
            <Button Content="Voltar à biblioteca" Click="Back_Click" Margin="0,0,8,8" Style="{StaticResource SecondaryButtonStyle}" />
            <Button Content="Abandonar texto" Click="Abandon_Click" Margin="0,0,8,8" Style="{StaticResource SecondaryButtonStyle}" />
            <Button Content="Encerrar sessão" Click="End_Click" Margin="0,0,8,8" Style="{StaticResource SecondaryButtonStyle}" />
        </WrapPanel>
    </StackPanel>
</UserControl>
