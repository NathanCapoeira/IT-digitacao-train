<Window x:Class="ITDigitacao.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ITDigitacao.App.Views"
        Title="IT Digitação • Instituto de Transformação"
        Icon="/IT-Digitacao;component/Assets/logo-it-digitacao.png"
        Width="1060" Height="720" MinWidth="390" MinHeight="340"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="{StaticResource CanvasBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="15" Language="pt-BR"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel MaxWidth="1150" Margin="20,0">
                <Grid MinHeight="63">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image Source="/IT-Digitacao;component/Assets/logo-it-digitacao.png"
                           Width="48" Height="48" Margin="0,0,10,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,4,8,4">
                        <TextBlock FontSize="23" FontWeight="Bold" Foreground="{StaticResource InkBrush}">
                            <Run Text="IT" Foreground="{StaticResource BrandRedBrush}" /><Run Text=" Digitação" />
                        </TextBlock>
                        <TextBlock Text="Instituto de Transformação" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButtonStyle}" Click="Settings_Click" ToolTip="Configurações"
                                AutomationProperties.Name="Abrir configurações">
                            <Image Source="{StaticResource SettingsIcon}" Width="23" Height="23" />
                        </Button>
                        <Button Content="Sai_r" Click="Exit_Click" Margin="8,0,0,0"
                                Style="{StaticResource SecondaryButtonStyle}" />
                    </StackPanel>
                </Grid>

                <WrapPanel Margin="0,0,0,4" KeyboardNavigation.TabNavigation="Once">
                    <WrapPanel.Resources>
                        <Style TargetType="RadioButton" BasedOn="{StaticResource NavigationStyle}">
                            <Setter Property="GroupName" Value="Navigation" />
                        </Style>
                    </WrapPanel.Resources>
                    <RadioButton x:Name="HomeTab" Click="Navigate_Click" AutomationProperties.Name="Início">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{StaticResource HomeIcon}" Width="16" Height="16" Margin="0,0,5,0" />
                            <TextBlock Text="Início" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="LibraryTab" Click="Navigate_Click" AutomationProperties.Name="Biblioteca">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{StaticResource LibraryIcon}" Width="16" Height="16" Margin="0,0,5,0" />
                            <TextBlock Text="Biblioteca" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="GuideTab" Click="Navigate_Click" AutomationProperties.Name="Como digitar">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{StaticResource KeyboardIcon}" Width="16" Height="16" Margin="0,0,5,0" />
                            <TextBlock Text="Como digitar" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="SettingsTab" Click="Navigate_Click" Content="Configurações" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource BrandDarkBrush}" TextBlock.Foreground="White">
            <Grid Margin="20,5" MaxWidth="1150">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <DockPanel Margin="0,0,10,0">
                    <Image Source="/IT-Digitacao;component/Assets/logo-instituto.png" Width="24" Height="24"
                           Margin="0,0,8,0" />
                    <TextBlock Text="Instituto de Transformação" FontSize="12" FontWeight="SemiBold"
                               TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="#FFD7D7" Margin="0,0,5,0" />
                    <TextBlock Text="Offline" FontSize="12" />
                    <TextBlock Text="•" Margin="8,0" Foreground="#FFB8B8" FontSize="12" />
                    <TextBlock Text="v1.1.0" FontSize="12" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer x:Name="PageScroller" VerticalScrollBarVisibility="Auto">
            <Grid MaxWidth="1150" Margin="20,18,20,12">
                <views:HomeView x:Name="HomePage" StartRequested="StartRequested" />
                <StackPanel x:Name="SectionPage" Visibility="Collapsed">
                    <Border Style="{StaticResource BannerStyle}">
                        <StackPanel>
                            <TextBlock x:Name="SectionTitle" FontSize="30" Foreground="White" FontWeight="Bold"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="SectionDescription" Foreground="White" Margin="0,6,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Em desenvolvimento" FontSize="21" FontWeight="Bold" />
                            <TextBlock x:Name="SelectedPlan" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Foreground="{StaticResource BrandDarkBrush}" Margin="0,8,0,0" />
                            <TextBlock x:Name="SectionStatus" TextWrapping="Wrap" Margin="0,8,0,0" />
                            <Button Content="Voltar ao _início" Click="ReturnHome_Click" HorizontalAlignment="Left"
                                    Margin="0,16,0,0" Style="{StaticResource SecondaryButtonStyle}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
