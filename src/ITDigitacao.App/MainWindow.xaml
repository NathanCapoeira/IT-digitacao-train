<Window x:Class="ITDigitacao.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IT Digitação" Width="1024" Height="700" MinWidth="440" MinHeight="360"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="{StaticResource CanvasBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="16" Language="pt-BR"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="24,10" MaxWidth="1100" MinHeight="48">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="IT Digitação" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource InkBrush}" />
                    <TextBlock Text="Instituto de Transformação" FontSize="13" TextWrapping="Wrap"
                               Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
                <Button Grid.Column="1" Content="Sai_r" Click="Exit_Click" VerticalAlignment="Center"
                        Style="{StaticResource SecondaryButtonStyle}" />
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel Margin="24,12" MaxWidth="1100" TextBlock.FontSize="13"
                       TextBlock.Foreground="{StaticResource MutedBrush}">
                <TextBlock DockPanel.Dock="Right" Text="Versão 1.0.0" Margin="12,0,0,0" />
                <TextBlock Text="Instituto de Transformação" TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24" MaxWidth="960">
                <Border Background="{StaticResource BannerBrush}" CornerRadius="16" Padding="28">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,10,0,10" TextBlock.Foreground="{StaticResource SurfaceBrush}">
                            <TextBlock Text="Aprenda. Pratique. Transforme." FontSize="15"
                                       FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="Bem-vindo ao IT Digitação!" FontSize="36" FontWeight="Bold"
                                       TextWrapping="Wrap" Margin="0,10,0,12" />
                            <TextBlock Text="Um espaço para praticar digitação e aprender no seu ritmo."
                                       FontSize="17" TextWrapping="Wrap" />
                        </StackPanel>
                        <Viewbox Grid.Column="1" MaxWidth="218" StretchDirection="DownOnly"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Margin="12,0,0,0" IsHitTestVisible="False">
                            <Grid Width="200" Height="140">
                                <Ellipse Width="126" Height="126" Fill="#19FFFFFF" />
                                <Border Width="188" Height="84" Background="#19FFFFFF" BorderBrush="#65FFFFFF"
                                        BorderThickness="1" CornerRadius="16">
                                    <Border.RenderTransform>
                                        <RotateTransform Angle="-8" CenterX="94" CenterY="42" />
                                    </Border.RenderTransform>
                                    <Grid Margin="14">
                                        <Grid.RowDefinitions>
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                        </Grid.RowDefinitions>
                                        <UniformGrid Columns="5">
                                            <Rectangle Fill="#65FFFFFF" RadiusX="3" RadiusY="3" Margin="2" />
                                            <Rectangle Fill="#65FFFFFF" RadiusX="3" RadiusY="3" Margin="2" />
                                            <Rectangle Fill="#65FFFFFF" RadiusX="3" RadiusY="3" Margin="2" />
                                            <Rectangle Fill="#65FFFFFF" RadiusX="3" RadiusY="3" Margin="2" />
                                            <Rectangle Fill="#65FFFFFF" RadiusX="3" RadiusY="3" Margin="2" />
                                        </UniformGrid>
                                        <UniformGrid Grid.Row="1" Columns="5">
                                            <Rectangle Fill="#65FFFFFF" RadiusX="3" RadiusY="3" Margin="2" />
                                            <Rectangle Fill="White" RadiusX="3" RadiusY="3" Margin="2" />
                                            <Rectangle Fill="#65FFFFFF" RadiusX="3" RadiusY="3" Margin="2" />
                                            <Rectangle Fill="White" RadiusX="3" RadiusY="3" Margin="2" />
                                            <Rectangle Fill="#65FFFFFF" RadiusX="3" RadiusY="3" Margin="2" />
                                        </UniformGrid>
                                        <Rectangle Grid.Row="2" Width="90" Fill="#65FFFFFF"
                                                   RadiusX="3" RadiusY="3" Margin="2" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Viewbox>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,20,0,0">
                    <StackPanel>
                        <TextBlock Text="Primeiros passos" FontSize="24" FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="StatusMessage" Margin="0,8,0,20" MinHeight="24"
                                   TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                                   AutomationProperties.LiveSetting="Polite" />
                        <WrapPanel>
                            <Button Content="_Testar interface" Click="TestInterface_Click" Margin="0,0,12,4"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                            <Button Content="_Restaurar" Click="Reset_Click" Margin="0,0,0,4"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
