<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="BrandRedColor">#D90000</Color>
    <Color x:Key="BrandDarkColor">#A60000</Color>

    <SolidColorBrush x:Key="BrandRedBrush" Color="{StaticResource BrandRedColor}" />
    <SolidColorBrush x:Key="BrandDarkBrush" Color="{StaticResource BrandDarkColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CanvasBrush" Color="#F4F6F9" />
    <SolidColorBrush x:Key="InkBrush" Color="#171717" />
    <SolidColorBrush x:Key="TextBrush" Color="#20242C" />
    <SolidColorBrush x:Key="MutedBrush" Color="#545C69" />
    <SolidColorBrush x:Key="BorderBrush" Color="#E2E5EA" />
    <SolidColorBrush x:Key="BrandTintBrush" Color="#FFF1F2" />

    <SolidColorBrush x:Key="AchievementTintBrush" Color="#FFF3D7" />

    <LinearGradientBrush x:Key="BannerBrush" StartPoint="0,0" EndPoint="1,0.9">
        <GradientStop Color="{StaticResource BrandDarkColor}" Offset="0" />
        <GradientStop Color="{StaticResource BrandRedColor}" Offset="0.63" />
        <GradientStop Color="{StaticResource BrandDarkColor}" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
